# Copy this file to terraform.tfvars and adjust values as needed
# DO NOT commit terraform.tfvars to version control

aws_region = "us-east-1"

web_acl_name        = "php2shell-rce-mitigation-acl"
web_acl_description = "Web ACL to apply edge-level mitigations for RCE vulnerabilities CVE-2026-109618 and CVE-2026-109619"
web_acl_scope       = "REGIONAL"  # Use "CLOUDFRONT" for CloudFront distributions (must be in us-east-1)

enable_cloudwatch_metrics = true
enable_sampled_requests   = true

metric_name = "Php2ShellMitigationMetric"

# Start in COUNT, review sampled requests, then switch to BLOCK
rule_action = "COUNT"

php_managed_rule_group_version = "Version_2.3"

# Both rules break uploads when set to BLOCK. Disable them on apps that accept file uploads.
enable_oversize_body_block = true
max_body_size_bytes        = 8192
enable_multipart_block     = true

tags = {
  Environment = "production"
  Project     = "security-php2shell-mitigation"
  ManagedBy   = "terraform"
  Owner       = "security-team"
}
